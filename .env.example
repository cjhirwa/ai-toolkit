# Provider keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Your documents (doc-ingest reads this folder when no path is given)
DOCS_DIR=docs
# Model that does OCR for doc-ingest --ocr llm (independent of LLMGW_DEFAULT_MODEL; must accept images)
DOCINGEST_OCR_MODEL=ollama:gemma3:4b
# Pages sent to OCR at once (default 4, or 1 for Ollama)
# DOCINGEST_OCR_CONCURRENCY=4
# Cache OCR text by page image (0 to turn off)
# DOCINGEST_OCR_CACHE=.llmgw/ocr-cache.sqlite

# llm-gateway
LLMGW_DEFAULT_MODEL=gemini:gemini-3.6-flash
LLMGW_EMBED_MODEL=gemini:gemini-embedding-2-preview
LLMGW_LOG_DIR=.llmgw/logs
# 1 = also log prompts and replies (useful for debugging); default 0 logs only metadata
LLMGW_LOG_CONTENT=0
# Cache embeddings by text hash (0 to turn off)
# LLMGW_EMBED_CACHE=.llmgw/embed-cache.sqlite
LLMGW_TIMEOUT=600
# Stop all calls once today's spend (UTC, from the call log) reaches this many dollars
# LLMGW_DAILY_BUDGET_USD=5
# Shared per-provider limits (Ollama defaults to 1 request at a time)
# LLMGW_RPM_GEMINI=60
# LLMGW_CONCURRENCY_OLLAMA=1

# eval-harness
EVALH_JUDGE_MODEL=gemini:gemini-3.1-pro-preview
EVALH_DB=evals.db

# prompt-registry / mcp-servers / playground
PROMPTS_DIR=prompts
RETRIEVAL_INDEX_DIR=data/index
RETRIEVAL_MODE=hybrid
PLAYGROUND_MODELS=gemini:gemini-3.6-flash,openai:gpt-4o-mini,ollama:llama3.1
